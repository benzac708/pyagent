# Primary provider (OpenAI-compatible)
BASE_URL=https://opencode.ai/inference/go/openai/v1
API_KEY=oc_sk_...
MODEL=beam-free

# Fallback provider (optional)
FALLBACK_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_API_KEY=gsk_...
FALLBACK_MODEL=openai/gpt-oss-120b

# App
DB_PATH=agent.db
LOG_LEVEL=info
MAX_ITERATIONS=10

# Demo mode (no API key needed): set to true
MOCK_LLM=false

# Security (optional)
# PYAGENT_API_KEY=change-me   # enables auth on POST /run, /runs, /conversations
# RATE_LIMIT_PER_MIN=10        # per-IP rate limit on /run
# BASH_ENABLED=true           # set false to disable bash tool
