[Unit]
Description=pyagent host actuator (scoped auto-remediation)
After=network.target

[Service]
Type=simple
User=root
EnvironmentFile=/opt/pyagent/.env
ExecStart=/usr/bin/python3 /opt/pyagent/vps-actuator.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF
echo "service written"