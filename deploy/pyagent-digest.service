[Unit]
Description=pyagent daily digest (example)
After=pyagent.service

[Service]
Type=oneshot
WorkingDirectory=/opt/pyagent
ExecStart=/usr/bin/docker compose exec -T -e MAX_ITERATIONS=5 pyagent uv run python -m agent "Run check_disk on /, check_services for ['pyagent','docker','caddy'], and check_backups on /home/ubuntu/backups/jobs/jobs.db. Then output a JSON object with keys: status (ok|warn|fail), findings (list of short strings), recommendations (list of short strings). Only include findings for checks that are not healthy. If everything is healthy, findings and recommendations must be empty lists."
EnvironmentFile=/opt/pyagent/.env

[Install]
WantedBy=multi-user.target
